        "\n",
        "# Based on the output, the correct file name is 'Ice Cream Sales and Temperature.csv'.\n",
        "# We will use this exact name.\n",
        "# To make it robust, we'll find the first .csv file in the list.\n",
        "csv_file_name = None\n",
        "for file in dataset_files:\n",
        "    if file.lower().endswith('.csv'):\n",
        "        csv_file_name = file\n",
        "        break\n",
        "\n",
        "if csv_file_name is None:\n",
        "    raise FileNotFoundError(\"No CSV file found in the dataset directory.\")\n",
        "\n",
        "full_csv_path = os.path.join(path, csv_file_name)\n",
        "print(f\"Attempting to load: {full_csv_path}\")\n",
        "\n",
        "# Load the CSV file into a pandas DataFrame\n",
        "df = pd.read_csv(full_csv_path)\n",
        "\n",
        "# Display the first 5 rows of the DataFrame\n",
        "display(df.head())"
